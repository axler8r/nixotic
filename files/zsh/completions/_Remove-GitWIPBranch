#compdef Remove-GitWIPBranch

_Remove-GitWIPBranch() {
  local state

  _arguments -C \
    '(- *)--help[show help]' \
    '1:WIP branch:->branch' \
    && return 0

  case $state in
    branch)
      local -a _branches
      _branches=(${(f)"$(git branch --list 'wip/*' 2>/dev/null | sed 's/^[* ]*//')"})
      compadd -a _branches
      ;;
  esac
}

_Remove-GitWIPBranch "$@"
