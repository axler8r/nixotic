#! /usr/bin/env zsh

# New-ToolDevEnvironment: Create a direnv + flake-parts ad-hoc tool environment

source "${0:h}/../lib/output.zsh"
source "${0:h}/../lib/validation.zsh"

# Defaults
local _name="${PWD:t}"
local -a _packages=()


# Help check ------------------------------------------------------------------
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat << EOF
Usage: ${0:t} [opts] packages...

Description:
    Create a new direnv + Nix Flakes ad-hoc tool environment using flake-parts.

Options:
    -h, --help              Show this help message
    --name NAME             Project name (default: current directory name)

Arguments:
    packages                Nix packages (bare names, e.g. jq ripgrep)

Examples:
    ${0:t} jq fd ripgrep               # Ad-hoc shell with tools
EOF
    return 0
fi


# Options ----------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
    case "$1" in
        --name)     _name="$2"; shift 2 ;;
        -*)         __ax_error "Unknown option: $1"; return 1 ;;
        *)          _packages+=("$1"); shift ;;
    esac
done


# Main -------------------------------------------------------------------------
__ax_check_deps direnv nix || return 2

if [[ ${#_packages[@]} -eq 0 ]]; then
    __ax_error "Usage: ${0:t} [opts] packages..."
    __ax_info "Use --help for more information"
    return 1
fi


# Driver -----------------------------------------------------------------------
function new_tool_dev_environment() {
    local name="$1"
    shift
    local -a packages=("$@")

    if [[ -f flake.nix ]]; then
        __ax_error "flake.nix already exists"
        return 1
    fi

    local all_packages=""
    if [[ ${#packages[@]} -gt 0 ]]; then
        all_packages=$(printf '            pkgs.%s\n' "${packages[@]}")
        all_packages="${all_packages%$'\n'}"
    fi

    cat > flake.nix << EOF
{
  description = "${name} development environment";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    flake-parts.url = "github:hercules-ci/flake-parts";
  };

  outputs = inputs@{ flake-parts, ... }:
    flake-parts.lib.mkFlake { inherit inputs; } {
      systems = [ "x86_64-linux" "aarch64-linux" "x86_64-darwin" "aarch64-darwin" ];

      perSystem = { pkgs, ... }: {
        devShells.default = pkgs.mkShell {
          name = "${name}";
          packages = [
${all_packages}
          ];
        };
      };
    };
}
EOF

    echo "Created flake.nix"

    if [[ -f .envrc ]]; then
        __ax_error ".envrc already exists"
        return 1
    fi

    echo "use flake" > .envrc
    echo "Created .envrc"

    if [[ -f .gitignore ]]; then
        if ! grep -q "^\.direnv$" .gitignore; then
            echo ".direnv" >> .gitignore
            echo "Added .direnv to .gitignore"
        fi
    fi

    direnv allow
    echo "Environment activated"
}


new_tool_dev_environment "$_name" "${_packages[@]}"


# Cleanup ----------------------------------------------------------------------
unfunction new_tool_dev_environment 2>/dev/null
