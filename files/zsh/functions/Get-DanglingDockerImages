#! /usr/bin/env zsh

# Get-DanglingDockerImages: List all dangling Docker images

source "${0:h}/../lib/output.zsh"
source "${0:h}/../lib/validation.zsh"

# Help -------------------------------------------------------------------------
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat << EOF
Usage: ${0:t} [--raw]

List all dangling Docker images (untagged, not referenced by any container).

Options:
    -h, --help    Show this help message
    --raw         Plain text output

Examples:
    ${0:t}
    ${0:t} --raw | awk -F'|' '{print $5}'
EOF
    return 0
fi


# Options ----------------------------------------------------------------------
local _raw_flag=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --raw)      _raw_flag="--raw" ;;
        *)          _arg=$1         ;;
    esac
    shift
done


# Main -------------------------------------------------------------------------
__ax_check_deps docker || return 2


# Driver -----------------------------------------------------------------------
function get_dockerdanglingimage() {
    local _header="Repository|Tag|Created|Size|ID"
    local _image=$(docker image list --format="{{.Repository}}|{{.Tag}}|{{.CreatedSince}}|{{.Size}}|{{.ID}}" --filter="dangling=true" | sort)
    echo ""
    echo -e "${_header}\n${_image}" | __ax_table $_raw_flag
    echo ""
}


get_dockerdanglingimage


unfunction get_dockerdanglingimage
