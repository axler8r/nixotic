#! /usr/bin/env zsh

# Complete-GitWIPBranch: Fast-forward stable to the current WIP branch

source "${0:h}/../lib/output.zsh"
source "${0:h}/../lib/validation.zsh"
source "${0:h}/../lib/git.zsh"

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat << EOF
Usage: ${0:t}

Fast-forward stable to the current wip/* branch.

Requirements:
  - Inside a Git repository
  - Clean Git worktree
  - Currently on a wip/* branch
  - Local stable branch exists

Notes:
  - This does not rewrite WIP history first.
  - This does not delete the merged branch.
EOF
    return 0
fi

__ax_require_git_repo || return $?
__ax_require_clean_git_worktree || return 1
__ax_require_branch_exists stable || return 1

typeset _wip_branch
_wip_branch="$(__ax_git_current_branch)" || return 1
__ax_require_wip_branch "${_wip_branch}" || return 1

git merge-base --is-ancestor stable "${_wip_branch}" \
    || { __ax_error "stable cannot be fast-forwarded to ${_wip_branch}. Rebase onto stable first."; return 1 }

git checkout stable > /dev/null \
    || { __ax_error "Could not switch to stable."; return 1 }

git merge --ff-only "${_wip_branch}" > /dev/null \
    || { __ax_error "Could not fast-forward stable to ${_wip_branch}."; return 1 }

__ax_success "Merged ${_wip_branch} into stable."
