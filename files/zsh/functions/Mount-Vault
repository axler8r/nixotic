#! /usr/bin/env zsh

# Mount-Vault: Mount a LUKS encrypted vault

source "${0:h}/../lib/output.zsh"
source "${0:h}/../lib/validation.zsh"

# Variables --------------------------------------------------------------------
local _synopsis="Synopsis:
    ${0:t} <vault-file> [mount-point]

See also:
    ${0:t} --help
"
local _help="Description:
    Mount a LUKS encrypted vault using cryptsetup and mount.
    Specify a vault name (e.g., 'mydata') to mount ${HOME}/Vaults/.<name>.vault
    Default mount point is ${HOME}/Vaults/<name>

Usage:
    ${0:t} <vault-name> [mount-point]

Options:
    --help      Show this help message

Arguments:
    vault-name      Vault name (e.g., mydata) or full path to vault file
    mount-point     Optional mount point (default: ${HOME}/Vaults/<vault-name>)

Examples:
    ${0:t} mydata
    ${0:t} secrets ~/mnt/secrets
    ${0:t} ~/Vaults/.mydata.vault      # Explicit path
"

# Defaults
local _vault_file=""
local _mount_point=""


# Functions --------------------------------------------------------------------
_synopsis() {
    echo "${_synopsis}" | tail --lines=+2
}

_help() {
    echo "${_help}" | tail --lines=+2
}


# Options ----------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
    case "$1" in
        --help)     _help_flag=true; shift ;;
        *)          
            if [[ -z "${_vault_file}" ]]; then
                _vault_file="$1"
            else
                _mount_point="$1"
            fi
            shift
            ;;
    esac
done


# Main -------------------------------------------------------------------------
[[ -n $_help_flag ]] && _help && return 0
__ax_require_arg "$_vault_file" "vault file" || { _synopsis; return 1; }
__ax_check_deps cryptsetup mount umount chown mkdir || return 2


# Driver -----------------------------------------------------------------------
function mount_vault() {
    local vault_input=${1}
    local mount_point=${2}
    local vault_file=""
    local vault_name=""
    
    # Detect if input is a path (contains /) or a vault name
    if [[ "${vault_input}" == */* ]]; then
        # Full path provided
        vault_file="${vault_input/#\~/$HOME}"
        vault_name="${vault_file:t:r:s/^\.//}"  # Extract name, remove leading dot
    else
        # Vault name provided - construct path
        vault_name="${vault_input}"
        vault_file="${HOME}/Vaults/.${vault_name}.vault"
    fi
    
    # Check if vault file exists
    if [[ ! -f "${vault_file}" ]]; then
        __ax_error "Vault file not found: ${vault_file}"
        return 1
    fi
    
    local mapper_name="${vault_name}"
    
    # Set default mount point if not provided
    if [[ -z "${mount_point}" ]]; then
        mount_point="${HOME}/Vaults/${vault_name}"
    fi
    
    # Check if already mounted
    if mount | grep --quiet "/dev/mapper/${mapper_name}"; then
        __ax_error "Vault already mounted"
        mount | grep "/dev/mapper/${mapper_name}"
        return 1
    fi
    
    echo "Opening encrypted vault: ${vault_file}"
    sudo cryptsetup open --type luks "${vault_file}" "${mapper_name}" || return 1
    
    # Create mount point if it doesn't exist
    if [[ ! -d "${mount_point}" ]]; then
        echo "Creating mount point: ${mount_point}"
        mkdir --parents "${mount_point}" || {
            sudo cryptsetup close "${mapper_name}"
            return 1
        }
    fi
    
    echo "Mounting to: ${mount_point}"
    sudo mount "/dev/mapper/${mapper_name}" "${mount_point}" || {
        sudo cryptsetup close "${mapper_name}"
        return 1
    }
    
    # Change ownership to current user
    sudo chown -R "$(id -u):$(id -g)" "${mount_point}"
    
    echo "Vault mounted successfully at: ${mount_point}"
}


mount_vault "${_vault_file}" "${_mount_point}"


# Cleanup ----------------------------------------------------------------------
unfunction _synopsis
unfunction _help
unfunction mount_vault

