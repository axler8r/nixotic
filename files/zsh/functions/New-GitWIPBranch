#! /usr/bin/env zsh

# New-GitWIPBranch: Create a new WIP branch with date and random suffix

source "${0:h}/../lib/output.zsh"
source "${0:h}/../lib/validation.zsh"
source "${0:h}/../lib/git.zsh"

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat << EOF
Usage: ${0:t}

Create and switch to a new branch named:
  wip/YYYYMMDD-<random7>

Requirements:
  - Inside a Git repository
  - Clean Git worktree
  - Currently on stable
EOF
    return 0
fi

__ax_require_git_repo || return $?
__ax_require_clean_git_worktree || return 1
__ax_require_branch_exists stable || return 1

typeset _current_branch
_current_branch="$(__ax_git_current_branch)" || return 1

[[ "${_current_branch}" == "stable" ]] \
    || { __ax_error "Current branch must be stable: ${_current_branch}"; return 1 }

typeset _branch=""
typeset _attempt
for _attempt in {1..10}; do
    _branch="wip/$(date +%Y%m%d)-$(LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 7)"
    if ! git show-ref --verify --quiet "refs/heads/${_branch}"; then
        break
    fi
    _branch=""
done

[[ -n "${_branch}" ]] || { __ax_error "Could not generate a unique WIP branch name."; return 1 }

git checkout -b "${_branch}" > /dev/null \
    || { __ax_error "Could not create branch: ${_branch}"; return 1 }

__ax_success "Created ${_branch}."
