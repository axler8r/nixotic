#! /usr/bin/env zsh

# Get-NfsExports: Check for exported NFS mounts on a server

source "${0:h}/../lib/output.zsh"
source "${0:h}/../lib/validation.zsh"

# Variables --------------------------------------------------------------------
local _synopsis="Synopsis:
    ${0:t} [opts] [server]

See also:
    ${0:t} --help
"
local _help="Description:
    Check for exported NFS mounts on a server using showmount.
    Displays all available NFS exports and their access permissions.

Usage:
    ${0:t} [opts] [server]

Options:
    --help      Show this help message

Arguments:
    server      NFS server hostname or IP (default: localhost)

Examples:
    ${0:t}                          # Check exports on localhost
    ${0:t} 192.168.1.10
    ${0:t} nfs.example.com
"


# Functions --------------------------------------------------------------------
_synopsis() {
    echo "${_synopsis}" | tail --lines=+2
}

_help() {
    echo "${_help}" | tail --lines=+2
}




# Options ----------------------------------------------------------------------
local _server="localhost"
local _raw_flag=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help)     _help_flag=true ;;
        --raw)      _raw_flag="--raw" ;;
        -*)         _error "Unknown option: $1" && return 1 ;;
        *)          _server="$1" ;;
    esac
    shift
done


# Main -------------------------------------------------------------------------
[[ -n $_help_flag ]] && _help && return 0


# Driver -----------------------------------------------------------------------
function get_nfs_exports() {
    local server="$1"
    local exports

    __ax_check_deps showmount || return 2

    __ax_info "Querying NFS exports on '$server'..."

    if ! exports=$(showmount -e "$server" 2>&1); then
        case "$exports" in
            *"Connection refused"*)
                __ax_error "Connection refused. NFS server may not be running on '$server'." ;;
            *"No route to host"*|*"Host is unreachable"*)
                __ax_error "Cannot reach host '$server'. Check network connectivity." ;;
            *"Name or service not known"*|*"not known"*)
                __ax_error "Cannot resolve hostname '$server'." ;;
            *"Permission denied"*|*"access denied"*)
                __ax_error "Permission denied when querying '$server'." ;;
            *"timed out"*|*"Timed out"*)
                __ax_error "Connection to '$server' timed out." ;;
            *)
                __ax_error "Failed to query NFS exports: $exports" ;;
        esac
        return 1
    fi

    if [[ -z "$exports" ]] || [[ "$exports" == "Export list for $server:" ]]; then
        __ax_warn "No NFS exports found on '$server'."
        return 0
    fi

    # Skip the first header line from showmount, reformat as pipe-delimited
    local _data
    _data=$(echo "$exports" | tail -n +2 | sed 's/[[:space:]]\+/|/')

    echo ""
    echo -e "Export|Clients\n${_data}" | __ax_table $_raw_flag
    echo ""

    local count=$(echo "$_data" | wc -l)
    if (( count > 0 )); then
        __ax_info "\nFound $count export(s) on '$server'."
    fi
}


get_nfs_exports "${_server}"


# Cleanup ----------------------------------------------------------------------
unfunction _synopsis _help get_nfs_exports
