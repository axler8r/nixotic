#! /usr/bin/env zsh

# Find-MixedIndentation: Find files that mix tabs and spaces for indentation

source "${0:h}/../lib/output.zsh"
source "${0:h}/../lib/validation.zsh"

# Variables --------------------------------------------------------------------
local _synopsis="Synopsis:
    ${0:t} [opts] [directory]

See also:
    ${0:t} --help
"
local _help="Description:
    Find files that use both tabs and spaces for indentation.
    Files using only tabs or only spaces are fine — only mixed
    indentation is reported. Uses fd to discover files (respects
    .gitignore) and grep for detection.

Usage:
    ${0:t} [opts] [directory]

Options:
    -e ext      Only check files with this extension (repeatable)
    --all       Include hidden files and ignored files
    --help      Show this help message

Arguments:
    directory   Target directory (default: current directory)

Examples:
    ${0:t}                          # Check current directory
    ${0:t} ~/projects               # Check specific directory
    ${0:t} -e py -e js              # Only Python and JavaScript files
    ${0:t} --all                    # Include hidden/ignored files
"


# Functions --------------------------------------------------------------------
_synopsis() {
    echo "${_synopsis}" | tail --lines=+2
}

_help() {
    echo "${_help}" | tail --lines=+2
}


# Options ----------------------------------------------------------------------
local -a _extensions
local _all_flag=""
local _raw_flag=""
local _directory=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help)     _help_flag=true ;;
        --all)      _all_flag=true ;;
        --raw)      _raw_flag="--raw" ;;
        -e)         shift; _extensions+=("$1") ;;
        -*)         __ax_error "Unknown option: $1" && _synopsis && return 1 ;;
        *)          _directory="$1" ;;
    esac
    shift
done


# Main -------------------------------------------------------------------------
[[ -n $_help_flag ]] && _help && return 0

_directory="${_directory:-.}"
__ax_require_dir "$_directory" || return 1
__ax_check_deps fd grep || return 2


# Driver -----------------------------------------------------------------------
function find_mixed_indentation() {
    local dir="$1"
    local all_flag="$2"
    shift 2
    local -a extensions=("$@")

    # Build fd arguments
    local -a fd_args=(--type f)
    [[ -n "$all_flag" ]] && fd_args+=(--hidden --no-ignore)

    if [[ ${#extensions[@]} -gt 0 ]]; then
        for ext in "${extensions[@]}"; do
            fd_args+=(--extension "$ext")
        done
    fi

    # Get file list
    local -a files
    files=("${(@f)$(fd "${fd_args[@]}" . "$dir" 2>/dev/null)}")

    if [[ ${#files[@]} -eq 0 || -z "${files[1]}" ]]; then
        __ax_info "No files found in '$dir'"
        return 0
    fi

    local mixed=0
    local checked=0
    local skipped=0
    local mime tab_lines space_lines rel_path
    local S="|"
    local csv=""

    # Column width tracking
    local w_tabs=4 w_spaces=6

    # First pass: collect results
    local -a results

    for file in "${files[@]}"; do
        [[ -z "$file" ]] && continue

        # Skip binary files
        mime=$(file --brief --mime-type "$file" 2>/dev/null)
        [[ "$mime" != text/* && "$mime" != application/json && "$mime" != application/xml ]] && {
            skipped=$(( skipped + 1 ))
            continue
        }

        # Skip empty files
        [[ ! -s "$file" ]] && {
            skipped=$(( skipped + 1 ))
            continue
        }

        checked=$(( checked + 1 ))

        # Detect indentation styles
        tab_lines=$(grep -cP '^\t' "$file" 2>/dev/null) || tab_lines=0
        space_lines=$(grep -cP '^ ' "$file" 2>/dev/null) || space_lines=0

        # Mixed = has BOTH tab-indented and space-indented lines
        if [[ $tab_lines -gt 0 && $space_lines -gt 0 ]]; then
            mixed=$(( mixed + 1 ))
            rel_path="${file#${dir%/}/}"

            # Track column widths
            local fmt_tabs=$(printf "%'d" "$tab_lines")
            local fmt_spaces=$(printf "%'d" "$space_lines")
            (( ${#fmt_tabs} > w_tabs )) && w_tabs=${#fmt_tabs}
            (( ${#fmt_spaces} > w_spaces )) && w_spaces=${#fmt_spaces}

            results+=("${tab_lines}:${space_lines}:${rel_path}")
        fi
    done

    if [[ $mixed -eq 0 ]]; then
        __ax_success "No mixed indentation found ($checked files checked, $skipped skipped)"
        return 0
    fi

    # Build table
    csv="File${S}${(l:${w_tabs}:: :):-Tabs}${S}${(l:${w_spaces}:: :):-Spaces}"

    for entry in "${results[@]}"; do
        tab_lines="${entry%%:*}"
        local rest="${entry#*:}"
        space_lines="${rest%%:*}"
        rel_path="${rest#*:}"

        local fmt_tabs=$(printf "%'d" "$tab_lines")
        local fmt_spaces=$(printf "%'d" "$space_lines")

        csv+="\n${rel_path}${S}${(l:${w_tabs}:: :)fmt_tabs}${S}${(l:${w_spaces}:: :)fmt_spaces}"
    done

    # Render table
    echo ""
    echo -e "$csv" | __ax_table $_raw_flag
    echo ""
    __ax_warn "$mixed file(s) with mixed indentation ($checked checked, $skipped skipped)"

    return 1
}


find_mixed_indentation "$_directory" "$_all_flag" "${_extensions[@]}"
local _rc=$?


# Cleanup ----------------------------------------------------------------------
unfunction _synopsis
unfunction _help
unfunction find_mixed_indentation

return $_rc
