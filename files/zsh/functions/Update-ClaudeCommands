#! /usr/bin/env zsh

# Update-ClaudeCommands: Refresh gist-managed Claude slash commands in the current project

source "${0:h}/../lib/output.zsh"
source "${0:h}/../lib/validation.zsh"

local _gist_id="${CLAUDE_COMMANDS_GIST:-}"
local _template="${HOME}/.claude/templates/project/axler8r.md"


# Help check ------------------------------------------------------------------
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat << EOF
Usage: ${0:t} [opts]

Description:
    Refresh the gist-managed Claude slash commands and axler8r workflow in the
    current project. Overwrites .claude/axler8r.md from the nixotic template,
    ensures .claude/CLAUDE.md imports it via @axler8r.md, and replaces
    start.md, resume.md, and finish.md in .claude/commands/axler8r/.
    User-added custom commands are left untouched.

Options:
    -h, --help          Show this help message
    --gist GIST_ID      Gist ID (overrides \$CLAUDE_COMMANDS_GIST)

Examples:
    ${0:t}
    ${0:t} --gist abc123def456
EOF
    return 0
fi


# Options ----------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
    case "$1" in
        --gist)     _gist_id="$2"; shift 2 ;;
        -*)         __ax_error "Unknown option: $1"; return 1 ;;
        *)          __ax_error "Unexpected argument: $1"; return 1 ;;
    esac
done


# Main -------------------------------------------------------------------------
__ax_check_deps git || return 2

if [[ ! -d .claude ]]; then
    __ax_error ".claude/ not found — run Initialize-ClaudeProject first"
    return 1
fi

if [[ -z "$_gist_id" ]]; then
    __ax_error "Gist ID not set. Set \$CLAUDE_COMMANDS_GIST or use --gist GIST_ID"
    return 1
fi


# Driver -----------------------------------------------------------------------
function update_claude_commands() {
    local gist_id="$1"
    local template="$2"
    local staging

    staging=$(mktemp -d) || { __ax_error "Failed to create temp directory"; return 1 }
    trap "rm -rf '${staging}'" EXIT INT TERM

    __ax_info "Cloning gist ${gist_id}..."
    if ! git clone "https://gist.github.com/${gist_id}.git" "${staging}/gist" --quiet 2>&1; then
        __ax_error "Failed to clone gist: ${gist_id}"
        return 1
    fi

    mkdir -p .claude/commands/axler8r

    local -a command_files=(start.md resume.md finish.md)
    local updated=0
    for cmd in "${command_files[@]}"; do
        if [[ -f "${staging}/gist/${cmd}" ]]; then
            cp "${staging}/gist/${cmd}" ".claude/commands/axler8r/${cmd}"
            __ax_info "Updated .claude/commands/axler8r/${cmd}"
            (( updated++ ))
        else
            __ax_warn "${cmd} not found in gist — skipping"
        fi
    done

    if [[ -f "$template" ]]; then
        cp "$template" .claude/axler8r.md
        __ax_info "Updated .claude/axler8r.md"
    else
        __ax_warn "Template not found: $template — skipping axler8r.md update"
    fi

    if [[ ! -f .claude/CLAUDE.md ]]; then
        print '@axler8r.md' > .claude/CLAUDE.md
        __ax_info "Created .claude/CLAUDE.md with @axler8r.md reference"
    elif ! grep -qF '@axler8r.md' .claude/CLAUDE.md; then
        printf '\n@axler8r.md\n' >> .claude/CLAUDE.md
        __ax_info "Added @axler8r.md reference to .claude/CLAUDE.md"
    fi

    __ax_success "Updated ${updated} command file(s)"
}


update_claude_commands "$_gist_id" "$_template"


# Cleanup ----------------------------------------------------------------------
unfunction update_claude_commands 2>/dev/null
