#! /usr/bin/env zsh

# ConvertTo-VideoHorizontal: Flip video horizontally with hardware acceleration

source "${0:h}/../lib/output.zsh"
source "${0:h}/../lib/validation.zsh"

# Help -------------------------------------------------------------------------
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat << EOF
Usage: ${0:t} <input> <output>

Description:
    Flips a video horizontally and re-encodes the audio to prevent timestamp
    sync issues. Attempts hardware acceleration first, then falls back to
    software processing if hardware is not available.

Options:
    -h, --help  Show this help message

Hardware Acceleration Setup:
    For Intel QSV (Quick Sync Video) - RECOMMENDED for Intel CPUs:
        sudo apt install vainfo intel-media-va-driver-non-free libva-dev libmfx-dev

    For NVIDIA NVENC (if you have an NVIDIA GPU):
        sudo apt install libnvidia-encode-535 (or current driver version)

    Test hardware support after installation:
        vainfo                          # Check Intel VA-API support
        ffmpeg -encoders | grep qsv     # Check Intel QSV encoders
        ffmpeg -encoders | grep nvenc   # Check NVIDIA NVENC encoders

Performance Comparison:
    - Software encoding: ~1-2x real-time
    - Intel QSV: ~5-8x real-time
    - NVIDIA NVENC: ~4-10x real-time

Supported Hardware:
    - Intel: 6th gen Core (Skylake) and newer with integrated graphics
    - NVIDIA: GTX 1050/1060 and newer, RTX series, Quadro P series

Examples:
    ${0:t} input.mp4 output.mp4
EOF
    return 0
fi

# Options -------------------------------------------------------------------------
local _input=""
local _output=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        *)
            if [[ -z $_input ]]; then
                _input=$1
            elif [[ -z $_output ]]; then
                _output=$1
            else
                __ax_error "Too many arguments"
                return 1
            fi
            ;;
    esac
    shift
done

# Main -------------------------------------------------------------------------
__ax_require_arg "$_input" "input file" || return 1
__ax_require_arg "$_output" "output file" || return 1
__ax_check_deps ffmpeg || return 2


# Driver -----------------------------------------------------------------------
function format_videohorizontal() {
    local input=${1}
    local output=${2}
    
    # Check if input file exists
    if [[ ! -f "$input" ]]; then
        __ax_error "Input file '$input' does not exist"
        return 1
    fi
    
    echo "Input file: $input"
    echo "Output file: $output"
    
    # Try hardware acceleration methods in order of preference
    echo "Attempting hardware-accelerated flip..."
    
    # Try Intel QSV/VPL with corrected syntax
    if ffmpeg -y -hwaccel qsv -hwaccel_output_format qsv -c:v h264_qsv -i "${input}" -vf "vpp_qsv=transpose=hflip" -c:v h264_qsv -preset fast -c:a aac -b:a 128k "${output}" 2>/dev/null; then
        echo "Intel QSV/VPL hardware acceleration successful!"
    # Try NVIDIA NVENC with simplified approach  
    elif ffmpeg -y -i "${input}" -vf "hflip" -c:v h264_nvenc -preset fast -c:a aac -b:a 128k "${output}" 2>/dev/null; then
        echo "NVIDIA NVENC hardware acceleration successful!"
    # Try VA-API (Intel integrated)  
    elif ffmpeg -y -hwaccel vaapi -hwaccel_output_format vaapi -hwaccel_device /dev/dri/renderD128 -i "${input}" -vf "scale_vaapi=w=-2:h=-2,hwdownload,format=nv12,hwupload,scale_vaapi=w=iw:h=ih:format=nv12" -c:v h264_vaapi -c:a aac -b:a 128k "${output}" 2>/dev/null; then
        echo "VA-API hardware acceleration successful!"
    else
        echo "All hardware acceleration methods failed, falling back to software processing..."
        # Software fallback with proper horizontal flip and audio re-encoding
        ffmpeg -y -i "${input}" -vf "hflip" -c:v libx264 -preset fast -crf 23 -c:a aac -b:a 128k "${output}"
    fi
    
    echo "Video flip complete: ${output}"
}


format_videohorizontal "${_input}" "${_output}"
