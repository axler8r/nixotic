#! /usr/bin/env zsh

# New-ElixirDevEnvironment: Create a direnv + flake-parts Elixir development environment

source "${0:h}/../lib/output.zsh"
source "${0:h}/../lib/validation.zsh"

# Defaults
local _name="${PWD:t}"
local _target=""
local -a _packages=()


# Help check ------------------------------------------------------------------
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat << EOF
Usage: ${0:t} [opts] [packages...]

Description:
    Create a new direnv + Nix Flakes Elixir development environment using flake-parts.
    Use mix to manage project dependencies.

Options:
    -h, --help              Show this help message
    --name NAME             Project name (default: current directory name)
    --target VERSION        Elixir version, e.g. 1.17 (default: elixir)

Arguments:
    packages                Additional Nix packages (bare names, e.g. jq ripgrep)

Examples:
    ${0:t}                             # Latest Elixir
    ${0:t} --target 1.17               # Elixir 1.17
    ${0:t} --target 1.17 jq ripgrep    # Elixir 1.17 + extra tools
EOF
    return 0
fi


# Options ----------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
    case "$1" in
        --name)     _name="$2"; shift 2 ;;
        --target)   _target="$2"; shift 2 ;;
        -*)         __ax_error "Unknown option: $1"; return 1 ;;
        *)          _packages+=("$1"); shift ;;
    esac
done


# Main -------------------------------------------------------------------------
__ax_check_deps direnv nix || return 2


# Driver -----------------------------------------------------------------------
function new_elixir_dev_environment() {
    local name="$1"
    local target="$2"
    shift 2
    local -a extra_packages=("$@")

    if [[ -f flake.nix ]]; then
        __ax_error "flake.nix already exists"
        return 1
    fi

    if [[ -n "$target" ]] && [[ ! "$target" =~ ^[0-9]+\.[0-9]+$ ]]; then
        __ax_error "Invalid target: $target (expected format: 1.17)"
        return 1
    fi

    local -a lang_pkg_names=()
    if [[ -n "$target" ]]; then
        lang_pkg_names=("elixir_${target//./_}")
    else
        lang_pkg_names=(elixir)
    fi

    local all_packages=""
    local lang_part=""
    local extra_part=""
    if [[ ${#lang_pkg_names[@]} -gt 0 ]]; then
        lang_part=$(printf '            pkgs.beamPackages.%s\n' "${lang_pkg_names[@]}")
    fi
    if [[ ${#extra_packages[@]} -gt 0 ]]; then
        extra_part=$(printf '            pkgs.%s\n' "${extra_packages[@]}")
    fi
    all_packages="${lang_part}${extra_part}"
    all_packages="${all_packages%$'\n'}"

    cat > flake.nix << EOF
{
  description = "${name} development environment";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    flake-parts.url = "github:hercules-ci/flake-parts";
  };

  outputs = inputs@{ flake-parts, ... }:
    flake-parts.lib.mkFlake { inherit inputs; } {
      systems = [ "x86_64-linux" "aarch64-linux" "x86_64-darwin" "aarch64-darwin" ];

      perSystem = { pkgs, ... }: {
        devShells.default = pkgs.mkShell {
          name = "${name}";
          packages = [
${all_packages}
          ];
        };
      };
    };
}
EOF

    echo "Created flake.nix"

    if [[ -f .envrc ]]; then
        __ax_error ".envrc already exists"
        return 1
    fi

    echo "use flake" > .envrc
    echo "Created .envrc"

    if [[ -f .gitignore ]]; then
        if ! grep -q "^\.direnv$" .gitignore; then
            echo ".direnv" >> .gitignore
            echo "Added .direnv to .gitignore"
        fi
    fi

    direnv allow
    echo "Environment activated"
}


new_elixir_dev_environment "$_name" "$_target" "${_packages[@]}"


# Cleanup ----------------------------------------------------------------------
unfunction new_elixir_dev_environment 2>/dev/null
