#! /usr/bin/env zsh

# Get-DockerImages: List all installed Docker images with details

source "${0:h}/../lib/output.zsh"
source "${0:h}/../lib/validation.zsh"

# Help -------------------------------------------------------------------------
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat << EOF
Usage: ${0:t} [--raw]

List all installed Docker images (excluding dangling).

Options:
    -h, --help    Show this help message
    --raw         Plain text output

Examples:
    ${0:t}
    ${0:t} --raw | grep nginx
EOF
    return 0
fi


# Options ----------------------------------------------------------------------
local _raw_flag=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --raw)      _raw_flag="--raw" ;;
        *)          _arg=$1         ;;
    esac
    shift
done


# Main -------------------------------------------------------------------------
__ax_check_deps docker || return 2


# Driver -----------------------------------------------------------------------
function get_dockerimage() {
    local _header="Repository|Tag|Created|ID"
    local _image=$(docker image list --format="{{.Repository}}|{{.Tag}}|{{.CreatedSince}}|{{.ID}}" --filter="dangling=false" | sort)
    echo ""
    echo -e "${_header}\n${_image}" | __ax_table $_raw_flag
    echo ""
}


get_dockerimage


unfunction get_dockerimage
