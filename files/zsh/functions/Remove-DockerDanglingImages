#! /usr/bin/env zsh

# Remove-DockerDanglingImages: Remove all dangling Docker images

source "${0:h}/../lib/output.zsh"
source "${0:h}/../lib/validation.zsh"

# Help check ---------------------------------------------------------------
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat << EOF
Usage: ${0:t}

Remove all dangling Docker images (images without a tag).

Options:
    -h, --help    Show this help message

Examples:
    ${0:t}
EOF
    return 0
fi


# Main -------------------------------------------------------------------------
__ax_check_deps docker || return 2


# Driver -----------------------------------------------------------------------
function remove_dockerdanglingimages() {
    local _ids=$(docker image list --filter="dangling=true" --format="{{.ID}}")
    local _id

    if [[ -z "${_ids}" ]]; then
        echo "No dangling images to remove."
        return 0
    fi

    for _id in ${(f)_ids}; do
        echo "Removing image: ${_id}"
        docker rmi "${_id}" || return 1
    done
}


remove_dockerdanglingimages


unfunction remove_dockerdanglingimages
