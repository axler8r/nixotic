#! /usr/bin/env zsh

# Get-GitHubGitIgnores: List available GitHub gitignore templates

source "${0:h}/../lib/output.zsh"
source "${0:h}/../lib/validation.zsh"

local _raw_flag=""

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat << EOF
Usage: ${0:t} [--raw]

List all available GitHub gitignore template names.

Options:
    -h, --help    Show this help message
    --raw         Plain list, no header, no pager

Examples:
    ${0:t}
    ${0:t} --raw | grep -i python
EOF
    return 0
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        --raw)  _raw_flag="--raw" ;;
        -*)     __ax_error "Unknown option: $1"; return 1 ;;
    esac
    shift
done

__ax_check_deps curl jq || return 2

local _list
_list=$(curl -s \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    https://api.github.com/gitignore/templates \
    | jq -r '.[]') || { __ax_error "Failed to fetch gitignore templates"; return 1 }

if [[ -n "$_raw_flag" ]] || [[ ! -t 1 ]]; then
    print -- "$_list"
else
    print -- "$_list" \
        | awk 'BEGIN{print "Language"; print "---------------------------"} {print}' \
        | less -R
fi
