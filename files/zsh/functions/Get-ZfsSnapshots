#! /usr/bin/env zsh

# Get-ZfsSnapshots: List all ZFS snapshots sorted by creation date

source "${0:h}/../lib/output.zsh"
source "${0:h}/../lib/validation.zsh"

local _raw_flag=""
local _dataset=""

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat << EOF
Usage: ${0:t} [--raw] [dataset]

List all ZFS snapshots sorted by creation date (newest first).

Options:
    -h, --help    Show this help message
    --raw         Tab-separated output, no header (suitable for awk/grep)

Arguments:
    dataset       Optional dataset name to filter snapshots

Examples:
    ${0:t}
    ${0:t} dpool/data
    ${0:t} --raw | awk -F'\t' '{print \$1}'
EOF
    return 0
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        --raw)  _raw_flag="--raw" ;;
        -*)     __ax_error "Unknown option: $1"; return 1 ;;
        *)      _dataset="$1" ;;
    esac
    shift
done

__ax_check_deps zfs || return 2

local -a _args=(-r -t snapshot -S creation -o name,used,referenced,creation)
if [[ -n "$_raw_flag" ]] || [[ ! -t 1 ]]; then
    _args+=(-H)
fi

if [[ -n "$_dataset" ]]; then
    zfs list "${_args[@]}" "$_dataset"
else
    zfs list "${_args[@]}"
fi
