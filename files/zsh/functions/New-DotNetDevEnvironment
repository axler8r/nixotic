#! /usr/bin/env zsh

# New-DotNetDevEnvironment: Create a direnv + flake-parts .NET development environment

source "${0:h}/../lib/output.zsh"
source "${0:h}/../lib/validation.zsh"

# Defaults
local _name="${PWD:t}"
local _target=""
local -a _packages=()


# Help check ------------------------------------------------------------------
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat << EOF
Usage: ${0:t} [opts] [packages...]

Description:
    Create a new direnv + Nix Flakes .NET development environment using flake-parts.
    Use dotnet CLI to manage project dependencies.

Options:
    -h, --help              Show this help message
    --name NAME             Project name (default: current directory name)
    --target VERSION        .NET SDK version: 8, 9, 10 (default: all three)

Arguments:
    packages                Additional Nix packages (bare names, e.g. jq ripgrep)

Examples:
    ${0:t}                             # .NET 8, 9 and 10
    ${0:t} --target 9                  # .NET 9 only
    ${0:t} --target 9 jq ripgrep       # .NET 9 + extra tools
EOF
    return 0
fi


# Options ----------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
    case "$1" in
        --name)     _name="$2"; shift 2 ;;
        --target)   _target="$2"; shift 2 ;;
        -*)         __ax_error "Unknown option: $1"; return 1 ;;
        *)          _packages+=("$1"); shift ;;
    esac
done


# Main -------------------------------------------------------------------------
__ax_check_deps direnv nix || return 2


# Driver -----------------------------------------------------------------------
function new_dotnet_dev_environment() {
    local name="$1"
    local target="$2"
    shift 2
    local -a extra_packages=("$@")

    if [[ -f flake.nix ]]; then
        __ax_error "flake.nix already exists"
        return 1
    fi

    if [[ -n "$target" ]] && [[ ! "$target" =~ ^(8|9|10)$ ]]; then
        __ax_error "Unknown target: $target (supported: 8, 9, 10)"
        return 1
    fi

    local -a sdk_pkg_names=()
    if [[ -n "$target" ]]; then
        sdk_pkg_names=("dotnet-sdk_${target}")
    else
        sdk_pkg_names=(dotnet-sdk_8 dotnet-sdk_9 dotnet-sdk_10)
    fi

    local all_packages=""
    local -a all_pkg_names=("${sdk_pkg_names[@]}" "${extra_packages[@]}")
    if [[ ${#all_pkg_names[@]} -gt 0 ]]; then
        all_packages=$(printf '            pkgs.%s\n' "${all_pkg_names[@]}")
        all_packages="${all_packages%$'\n'}"
    fi

    local env_attrs=$'\n          DOTNET_CLI_TELEMETRY_OPTOUT = "1";\n          DOTNET_NOLOGO = "1";'

    cat > flake.nix << EOF
{
  description = "${name} development environment";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    flake-parts.url = "github:hercules-ci/flake-parts";
  };

  outputs = inputs@{ flake-parts, ... }:
    flake-parts.lib.mkFlake { inherit inputs; } {
      systems = [ "x86_64-linux" "aarch64-linux" "x86_64-darwin" "aarch64-darwin" ];

      perSystem = { pkgs, ... }: {
        devShells.default = pkgs.mkShell {
          name = "${name}";
          packages = [
${all_packages}
          ];${env_attrs}
        };
      };
    };
}
EOF

    echo "Created flake.nix"

    if [[ -f .envrc ]]; then
        __ax_error ".envrc already exists"
        return 1
    fi

    echo "use flake" > .envrc
    echo "Created .envrc"

    if [[ -f .gitignore ]]; then
        if ! grep -q "^\.direnv$" .gitignore; then
            echo ".direnv" >> .gitignore
            echo "Added .direnv to .gitignore"
        fi
    fi

    direnv allow
    echo "Environment activated"
}


new_dotnet_dev_environment "$_name" "$_target" "${_packages[@]}"


# Cleanup ----------------------------------------------------------------------
unfunction new_dotnet_dev_environment 2>/dev/null
