#! /usr/bin/env zsh

# Set-TrailingNewline: Ensure text files end with exactly one newline

source "${0:h}/../lib/output.zsh"
source "${0:h}/../lib/validation.zsh"
source "${0:h}/../lib/trailing-newline.zsh"

# Help -------------------------------------------------------------------------
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat << EOF
Usage: ${0:t} [opts] [directory]

Ensure all text files in a directory tree end with exactly one newline.
Strips trailing blank lines and adds a final newline if missing.
Uses fd to discover files (respects .gitignore) and file(1) for
binary detection.

Options:
    --verbose   List each file as it is processed
    -e ext      Only process files with this extension (repeatable)
    --all       Include hidden files and ignored files
    -h, --help  Show this help message

Arguments:
    directory   Target directory (default: current directory)

Examples:
    ${0:t}                          # Fix all files in current directory
    ${0:t} -e nix -e md             # Only fix .nix and .md files
    ${0:t} ~/projects               # Fix files in specific directory
EOF
    return 0
fi

# Options ----------------------------------------------------------------------
local -a _extensions
local _all_flag=""
local _directory=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --verbose)  _verbose_flag=true ;;
        --all)      _all_flag=true ;;
        -e)         shift; _extensions+=("$1") ;;
        -*)         __ax_error "Unknown option: $1" && return 1 ;;
        *)          _directory="$1" ;;
    esac
    shift
done


# Main -------------------------------------------------------------------------

_directory="${_directory:-.}"
__ax_require_dir "$_directory" || return 1
__ax_check_deps fd file || return 2

__ax_trailing_newline_process "fix" "$_directory" "$_all_flag" "${_extensions[@]}"
local _rc=$?


return $_rc
