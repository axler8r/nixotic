#! /usr/bin/env zsh

# Remove-DockerDanglingVolumes: Remove all dangling Docker volumes

source "${0:h}/../lib/output.zsh"
source "${0:h}/../lib/validation.zsh"

# Help check ---------------------------------------------------------------
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat << EOF
Usage: ${0:t}

Remove all dangling Docker volumes (volumes not attached to any container).

Options:
    -h, --help    Show this help message

Examples:
    ${0:t}
EOF
    return 0
fi


# Main -------------------------------------------------------------------------
__ax_check_deps docker || return 2


# Driver -----------------------------------------------------------------------
function remove_dockerdanglingvolumes() {
    local _volumes=$(docker volume list --quiet --filter="dangling=true")
    local _volume

    if [[ -z "${_volumes}" ]]; then
        echo "No dangling volumes to remove."
        return 0
    fi

    for _volume in ${(f)_volumes}; do
        echo "Removing volume: ${_volume}"
        docker volume rm "${_volume}" || return 1
    done
}


remove_dockerdanglingvolumes


unfunction remove_dockerdanglingvolumes
