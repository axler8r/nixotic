#! /usr/bin/env zsh

# New-Vault: Create a new LUKS encrypted vault

# Variables --------------------------------------------------------------------
local _synopsis="Synopsis:
    ${0:t} <vault-name> [opts]

See also:
    ${0:t} --help
"
local _help="Description:
    Create a new LUKS encrypted vault using fallocate, cryptsetup, and mkfs.
    Specify a vault name (e.g., 'mydata') to create at ${HOME}/Vaults/.<name>.vault
    Mount points are created at ${HOME}/Vaults/<name> by default.

Usage:
    ${0:t} <vault-name> [opts]

Options:
    --help              Show this help message
    --size SIZE         Vault size (default: 1G, minimum: 100M, examples: 1G, 5G, 10G)
    --filesystem TYPE   Filesystem type (default: ext4)
    --location DIR      Directory to store vault file (default: ${HOME}/Vaults)

Examples:
    ${0:t} mydata
    ${0:t} secrets --size 1G
    ${0:t} backup --size 5G --filesystem ext4
    ${0:t} external --location /mnt/storage
"

# Defaults
local _vault_name=""
local _size="1G"
local _filesystem="ext4"
local _location="${HOME}/Vaults"


# Functions --------------------------------------------------------------------
_synopsis() {
    echo "${_synopsis}" | tail --lines=+2
}

_help() {
    echo "${_help}" | tail --lines=+2
}


# Options ----------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
    case "$1" in
        --help)         _help_flag=true; shift ;;
        --size)         _size="$2"; shift 2 ;;
        --filesystem)   _filesystem="$2"; shift 2 ;;
        --location)     _location="$2"; shift 2 ;;
        *)              _vault_name="$1"; shift ;;
    esac
done


# Main -------------------------------------------------------------------------
[[ -n $_help_flag ]] && _help && return 0
[[ -z $_vault_name ]] && echo "Error: Vault name required" && _synopsis && return 1


# Driver -----------------------------------------------------------------------
function new_vault() {
    local vault_name=${1}
    local size=${2}
    local filesystem=${3}
    local location=${4}
    
    local vault_file="${location}/.${vault_name}.vault"
    local mapper_name="${vault_name}"
    
    # Create vault directory if it doesn't exist
    if [[ ! -d "${location}" ]]; then
        echo "Creating vault directory: ${location}"
        mkdir --parents "${location}" || return 1
    fi
    
    # Check if vault already exists
    if [[ -f "${vault_file}" ]]; then
        echo "Error: Vault already exists: ${vault_file}"
        return 1
    fi
    
    echo "Creating vault: ${vault_file} (${size})"
    
    # Allocate space for vault file
    fallocate --length "${size}" "${vault_file}" || return 1
    
    echo "Encrypting vault with LUKS..."
    cryptsetup luksFormat --verify-passphrase "${vault_file}" || {
        rm --force "${vault_file}"
        return 1
    }
    
    echo "Opening encrypted vault..."
    sudo cryptsetup open --type luks "${vault_file}" "${mapper_name}" || {
        rm --force "${vault_file}"
        return 1
    }
    
    echo "Creating ${filesystem} filesystem..."
    sudo mkfs.${filesystem} -L "${vault_name}" "/dev/mapper/${mapper_name}" || {
        sudo cryptsetup close "${mapper_name}"
        rm --force "${vault_file}"
        return 1
    }
    
    echo "Closing vault..."
    sudo cryptsetup close "${mapper_name}"
    
    echo "Vault created successfully: ${vault_file}"
    echo "Mount with: mount-vault ${vault_file}"
}


new_vault "${_vault_name}" "${_size}" "${_filesystem}" "${_location}"


# Cleanup ----------------------------------------------------------------------
unfunction _synopsis
unfunction _help
unfunction new_vault

