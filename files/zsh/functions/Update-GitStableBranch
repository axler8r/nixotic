#! /usr/bin/env zsh

# Update-GitStableBranch: Switch to stable and fast-forward from origin/stable

source "${0:h}/../lib/output.zsh"
source "${0:h}/../lib/validation.zsh"
source "${0:h}/../lib/git.zsh"

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat << EOF
Usage: ${0:t}

Switch to stable and fast-forward it from origin/stable.

Requirements:
  - Inside a Git repository
  - Clean Git worktree
  - Local stable branch exists
  - origin remote exists
EOF
    return 0
fi

__ax_require_git_repo || return $?
__ax_require_clean_git_worktree || return 1
__ax_require_branch_exists stable || return 1

git remote get-url origin > /dev/null 2>&1 \
    || { __ax_error "Remote not found: origin"; return 1 }

git checkout stable > /dev/null \
    || { __ax_error "Could not switch to stable."; return 1 }

git pull --ff-only origin stable \
    || { __ax_error "Could not fast-forward stable from origin/stable."; return 1 }

__ax_success "Updated stable."
