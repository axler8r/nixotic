#! /usr/bin/env zsh

# Resolve-GitRepositoryPath: Resolve and display git repository path information

source "${0:h}/../lib/output.zsh"
source "${0:h}/../lib/validation.zsh"

# Options ----------------------------------------------------------------------
local _raw_flag=""

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat << EOF
Usage: ${0:t} [opts]

Description:
    Maps git repository directories to their remote fetch URLs.

Options:
    -h, --help    Show this help message
    --raw         Display output in raw format

Examples:
    ${0:t}
EOF
    return 0
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        --raw)      _raw_flag="--raw" ;;
        *)          _arg=$1         ;;
    esac
    shift
done

# Main -------------------------------------------------------------------------
__ax_check_deps git || return 2


# Driver -----------------------------------------------------------------------
function resolve_gitpathrepository() {
    local _data
    _data=$(foreach __AX_DIRECTORY in *(/)
    do
        pushd "$__AX_DIRECTORY" > /dev/null || return 1
        if git rev-parse --git-dir > /dev/null 2>&1; then
            git remote --verbose | grep "fetch"
            pwd
        fi
        popd > /dev/null || return 1
    done \
    | sed --expression="s/origin//" \
    | sed --expression="s/ (fetch)//" \
    | paste --delimiters="|" - -) || return 1

    echo ""
    echo -e "Remote|Path\n${_data}" | __ax_table $_raw_flag
    echo ""
}


resolve_gitpathrepository


unfunction resolve_gitpathrepository
