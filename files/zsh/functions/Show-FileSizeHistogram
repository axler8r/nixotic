#! /usr/bin/env zsh

# Show-FileSizeHistogram: Display file size distribution as a histogram

source "${0:h}/../lib/output.zsh"
source "${0:h}/../lib/validation.zsh"

# Variables --------------------------------------------------------------------
local _synopsis="Synopsis:
    ${0:t} [opts] [directory]

See also:
    ${0:t} --help
"
local _help="Description:
    Display a histogram of file sizes in a directory tree.
    Uses logarithmic bins (powers of 10) by default for a natural
    distribution view. Uses fd to discover files (respects .gitignore).

Usage:
    ${0:t} [opts] [directory]

Options:
    -e ext      Only count files with this extension (repeatable)
    --all       Include hidden files and ignored files
    --help      Show this help message

Arguments:
    directory   Target directory (default: current directory)

Examples:
    ${0:t}                          # Histogram of current directory
    ${0:t} ~/projects               # Histogram of specific directory
    ${0:t} -e jpg -e png            # Only image files
    ${0:t} --all                    # Include hidden/ignored files
"


# Functions --------------------------------------------------------------------
_synopsis() {
    echo "${_synopsis}" | tail --lines=+2
}

_help() {
    echo "${_help}" | tail --lines=+2
}


# Options ----------------------------------------------------------------------
local -a _extensions
local _all_flag=""
local _raw_flag=""
local _directory=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help)     _help_flag=true ;;
        --all)      _all_flag=true ;;
        --raw)      _raw_flag="--raw" ;;
        -e)         shift; _extensions+=("$1") ;;
        -*)         __ax_error "Unknown option: $1" && _synopsis && return 1 ;;
        *)          _directory="$1" ;;
    esac
    shift
done


# Main -------------------------------------------------------------------------
[[ -n $_help_flag ]] && _help && return 0

_directory="${_directory:-.}"
__ax_require_dir "$_directory" || return 1
__ax_check_deps fd || return 2


# Driver -----------------------------------------------------------------------
function show_file_size_histogram() {
    local dir="$1"
    local all_flag="$2"
    shift 2
    local -a extensions=("$@")

    # Build fd arguments
    local -a fd_args=(--type f)
    [[ -n "$all_flag" ]] && fd_args+=(--hidden --no-ignore)

    if [[ ${#extensions[@]} -gt 0 ]]; then
        for ext in "${extensions[@]}"; do
            fd_args+=(--extension "$ext")
        done
    fi

    # Logarithmic bin boundaries (in bytes)
    local -a bin_limits=(
        1024              # 1 KB
        10240             # 10 KB
        102400            # 100 KB
        1048576           # 1 MB
        10485760          # 10 MB
        104857600         # 100 MB
        1073741824        # 1 GB
    )
    local -a bin_labels=(
        "   0B -   1KB"
        "  1KB -  10KB"
        " 10KB - 100KB"
        "100KB -   1MB"
        "  1MB -  10MB"
        " 10MB - 100MB"
        "100MB -   1GB"
        "  1GB+       "
    )

    local num_bins=${#bin_labels}
    local -a bin_counts
    local i
    for (( i = 1; i <= num_bins; i++ )); do
        bin_counts[$i]=0
    done

    local total_files=0
    local total_bytes=0
    local file_size placed

    # Collect file sizes
    while IFS= read -r file; do
        [[ -z "$file" ]] && continue
        file_size=$(stat --format='%s' "$file" 2>/dev/null) || continue

        total_files=$(( total_files + 1 ))
        total_bytes=$(( total_bytes + file_size ))

        # Find the right bin
        placed=false
        for (( i = 1; i <= ${#bin_limits}; i++ )); do
            if (( file_size < bin_limits[i] )); then
                bin_counts[$i]=$(( bin_counts[$i] + 1 ))
                placed=true
                break
            fi
        done
        # Last bin (>= 1GB)
        [[ "$placed" == false ]] && bin_counts[$num_bins]=$(( bin_counts[$num_bins] + 1 ))
    done < <(fd "${fd_args[@]}" . "$dir" 2>/dev/null)

    if [[ $total_files -eq 0 ]]; then
        __ax_warn "No files found in '$dir'"
        return 0
    fi

    # Find max count for bar scaling
    local max_count=0
    for (( i = 1; i <= num_bins; i++ )); do
        (( bin_counts[i] > max_count )) && max_count=${bin_counts[i]}
    done

    # Bar width for histogram column
    local bar_width=30

    # Column width for file counts (right-aligned)
    local count_width=${#max_count}
    (( count_width < 5 )) && count_width=5

    # Format total size
    local size_label
    if (( total_bytes >= 1073741824 )); then
        size_label="$(printf '%.1f GB' "$(( total_bytes / 1073741824.0 ))")"
    elif (( total_bytes >= 1048576 )); then
        size_label="$(printf '%.1f MB' "$(( total_bytes / 1048576.0 ))")"
    elif (( total_bytes >= 1024 )); then
        size_label="$(printf '%.1f KB' "$(( total_bytes / 1024.0 ))")"
    else
        size_label="${total_bytes} B"
    fi

    # Build table data with pipe separator
    local S="|"
    local csv="Range${S}${(l:${bar_width}:: :):-Distribution}${S}${(l:${count_width}:: :):-Files}"

    local count bar_len filled pct_label
    for (( i = 1; i <= num_bins; i++ )); do
        count=${bin_counts[$i]}
        if (( max_count > 0 )); then
            bar_len=$(( count * bar_width / max_count ))
        else
            bar_len=0
        fi

        # Build bar string (left-aligned, padded to bar_width)
        filled=""
        for (( j = 0; j < bar_len; j++ )); do
            filled+="█"
        done
        # Pad bar to fixed width (right-pad with spaces for left-alignment)
        filled="${filled}${(l:$(( bar_width - bar_len )):: :)}"

        csv+="\n${bin_labels[$i]}${S}${filled}${S}${(l:${count_width}:: :)count}"
    done

    # Render
    echo ""
    __ax_info "${total_files} files, ${size_label}"
    echo ""
    echo -e "$csv" | __ax_table $_raw_flag
    echo ""
}


show_file_size_histogram "$_directory" "$_all_flag" "${_extensions[@]}"


# Cleanup ----------------------------------------------------------------------
unfunction _synopsis
unfunction _help
unfunction show_file_size_histogram
