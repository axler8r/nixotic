#! /usr/bin/env zsh

# Get-GitHubLicenses: List all available GitHub licenses

source "${0:h}/../lib/output.zsh"

local _raw_flag=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --help) echo "Usage: ${0:t} [--raw]" && return 0 ;;
        --raw)  _raw_flag="--raw" ;;
    esac
    shift
done

local _data
_data=$(curl -s https://api.github.com/licenses | jq -r '.[] | "\(.key)|\(.name)"')

echo ""
echo -e "Key|Name\n${_data}" | __ax_table $_raw_flag
echo ""
