#! /usr/bin/env zsh

# New-GitTag: Compute and create the next semver tag for HEAD based on its commit type

source "${0:h}/../lib/output.zsh"
source "${0:h}/../lib/validation.zsh"
source "${0:h}/../lib/git.zsh"

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat << EOF
Usage: ${0:t} [--dry-run]

Compute the next tag from HEAD's commit type and the last matching tag,
then create it as a signed annotated tag: v<MAJOR>.<MINOR>.0+<timestamp>.

  MAJOR bump (MINOR resets to 0): feat, feat!
  MINOR bump:                     refactor, defect, dep, sec
  no tag:                         everything else

Options:
  --dry-run   Print the computed tag without creating it.

Requirements:
  - Inside a Git repository
  - HEAD not already tagged
EOF
    return 0
fi

typeset _dry_run=0
[[ "$1" == "--dry-run" ]] && _dry_run=1

__ax_require_git_repo || return $?

typeset _existing
_existing="$(git tag --points-at HEAD)"
[[ -z "${_existing}" ]] \
    || { __ax_error "HEAD is already tagged: ${_existing}"; return 1 }

typeset _subject
_subject="$(git log -1 --format=%s)"

typeset _type
if [[ "${_subject}" =~ '^([a-z]+)(!)?(\([^)]*\))?:' ]]; then
    _type="${match[1]}"
else
    __ax_success "No tag needed: could not determine a commit type."
    return 0
fi

typeset _tier
case "${_type}" in
    feat)
        _tier="major"
        ;;
    refactor|defect|dep|sec)
        _tier="minor"
        ;;
    *)
        __ax_success "No tag needed for type: ${_type}."
        return 0
        ;;
esac

typeset _last_tag _major _minor
_last_tag="$(git tag -l 'v*.*.0+*' --sort=-v:refname | head -1)"

if [[ -n "${_last_tag}" && "${_last_tag}" =~ '^v([0-9]+)\.([0-9]+)\.0\+[0-9]{14}$' ]]; then
    _major="${match[1]}"
    _minor="${match[2]}"
else
    _major=0
    _minor=0
fi

if [[ "${_tier}" == "major" ]]; then
    (( _major += 1 ))
    _minor=0
else
    (( _minor += 1 ))
fi

typeset _tag="v${_major}.${_minor}.0+$(date +%Y%m%d%H%M%S)"

if (( _dry_run )); then
    print -- "${_tag}"
    return 0
fi

typeset _msg="${${_tag#v}%%+*}"

git tag -s -a "${_tag}" -m "${_msg}" \
    || { __ax_error "Could not create tag: ${_tag}"; return 1 }

__ax_success "Tagged ${_tag}."
