#! /usr/bin/env zsh

# Get-DockerDanglingVolumes: List all dangling Docker volumes

source "${0:h}/../lib/output.zsh"
source "${0:h}/../lib/validation.zsh"

# Help -------------------------------------------------------------------------
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat << EOF
Usage: ${0:t} [--raw]

List all dangling Docker volumes (not attached to any container).

Options:
    -h, --help    Show this help message
    --raw         Plain text output

Examples:
    ${0:t}
    ${0:t} --raw | awk -F'|' '{print $2}'
EOF
    return 0
fi


# Options ----------------------------------------------------------------------
local _raw_flag=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --raw)      _raw_flag="--raw" ;;
        *)          _arg=$1         ;;
    esac
    shift
done


# Main -------------------------------------------------------------------------
__ax_check_deps docker || return 2


# Driver -----------------------------------------------------------------------
function get_dockerdanglingvolumes() {
    local _data
    _data=$(docker volume list --filter="dangling=true" --format="{{.Driver}}|{{.Name}}")

    if [[ -z "$_data" ]]; then
        echo "No dangling volumes found."
        return 0
    fi

    echo ""
    echo -e "Driver|Volume Name\n${_data}" | __ax_table $_raw_flag
    echo ""
}


get_dockerdanglingvolumes


unfunction get_dockerdanglingvolumes
