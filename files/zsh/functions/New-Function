import argparse
import os
import re
import sys
from datetime import datetime
from pathlib import Path
from typing import NoReturn, Optional


class Colors:
    """ANSI color codes for terminal output"""
    RED = '\033[0;31m'
    GREEN = '\033[0;32m'
    YELLOW = '\033[1;33m'
    BLUE = '\033[0;34m'
    NC = '\033[0m'  # No Color


class Logger:
    """Simple logging utility"""

    def __init__(self, verbose: bool = False):
        self.verbose: bool = verbose

    def info(self, message: str) -> None:
        print(f"{Colors.BLUE}[INFO]{Colors.NC} {message}", file=sys.stderr)

    def success(self, message: str) -> None:
        print(f"{Colors.GREEN}[SUCCESS]{Colors.NC} {message}", file=sys.stderr)

    def error(self, message: str) -> None:
        print(f"{Colors.RED}[ERROR]{Colors.NC} {message}", file=sys.stderr)

    def warn(self, message: str) -> None:
        print(f"{Colors.YELLOW}[WARN]{Colors.NC} {message}", file=sys.stderr)

    def verbose_log(self, message: str) -> None:
        if self.verbose:
            print(f"{Colors.BLUE}[VERBOSE]{Colors.NC} {message}", file=sys.stderr)


def error_exit(message: str, exit_code: int = 1) -> NoReturn:
    """Print error message and exit"""
    Logger().error(message)
    sys.exit(exit_code)


def validate_name(name: str) -> bool:
    """Validate that name follows Verb-Noun convention (PascalCase or lowercase)"""
    # Accept: Get-Data, get-data, Get-DataFile, get-datafile
    pattern = r'^[A-Za-z]+(-[A-Za-z]+)+$'
    return bool(re.match(pattern, name))


def to_pascal_case(name: str) -> str:
    """Convert hyphenated name to PascalCase: get-data -> Get-Data"""
    return '-'.join(word.capitalize() for word in name.split('-'))


def to_snake_case(name: str) -> str:
    """Convert hyphenated name to snake_case for internal functions: Get-Data -> get_data"""
    return name.lower().replace('-', '_')


def get_default_output_dir() -> Path:
    """Get the default output directory (functions folder)"""
    # Try to find functions directory relative to script location
    script_dir = Path(__file__).parent
    if script_dir.name == 'functions':
        return script_dir
    
    # Check common locations
    candidates = [
        Path.home() / '.nixotic' / 'files' / 'zsh' / 'functions',
        Path.home() / '.zsh' / 'functions',
        script_dir / 'functions',
    ]
    
    for candidate in candidates:
        if candidate.exists():
            return candidate
    
    # Default to current directory
    return Path.cwd()


def generate_wrapper_template(name: str) -> str:
    """Generate a wrapper template - simple command wrapper (1-15 lines)"""
    pascal_name = to_pascal_case(name)
    return f'''#! /usr/bin/env zsh

# {pascal_name}: Brief description

source "${{0:h}}/../lib/output.zsh"
source "${{0:h}}/../lib/validation.zsh"

[[ "$1" == "--help" ]] && echo "Usage: ${{0:t}} [args]" && return 0

# Main logic here
echo "Executing {pascal_name}"
'''


def generate_function_template(name: str, description: Optional[str] = None) -> str:
    """Generate a function template - structured zsh function (16-80 lines)"""
    pascal_name = to_pascal_case(name)
    snake_name = to_snake_case(name)
    desc: str = description or f"Description of {pascal_name}"
    
    return f'''#! /usr/bin/env zsh

# {pascal_name}: {desc}

source "${{0:h}}/../lib/output.zsh"
source "${{0:h}}/../lib/validation.zsh"

# Variables --------------------------------------------------------------------
local _synopsis="Synopsis:
    ${{0:t}} [opts] [args]

See also:
    ${{0:t}} --help
"
local _help="Description:
    {desc}

Usage:
    ${{0:t}} [opts] [args]

Options:
    --help      Show this help message.
    [Add other options here]

Examples:
    ${{0:t}} arg1 arg2
"


# Functions --------------------------------------------------------------------
_synopsis() {{
    echo "${{_synopsis}}" | tail --lines=+2
}}

_help() {{
    echo "${{_help}}" | tail --lines=+2
}}


# Options ----------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
    case "$1" in
        --help)     _help_flag=true ;;
        --opt1)     _opt1_flag=true ;;
        *)          _args=$1        ;;
    esac
    shift
done


# Main -------------------------------------------------------------------------
[[ -n $_help_flag ]] && _help && return 0
__ax_require_arg "$_args" "argument" || return 1


# Driver -----------------------------------------------------------------------
function {snake_name}() {{
    local arg=${{1}}
    
    # Add function logic here
    echo "Executing {pascal_name} with: ${{arg}}"
}}


{snake_name} "${{_args}}"


# Cleanup ----------------------------------------------------------------------
unfunction _synopsis
unfunction _help
unfunction {snake_name}

'''


def generate_script_template(
        name: str,
        description: Optional[str] = None,
        author: Optional[str] = None,
        version: str = "1.0"
    ) -> str:
    """Generate a script template - full-featured automation script (81+ lines)"""
    pascal_name = to_pascal_case(name)
    snake_name = to_snake_case(name)
    desc: str = description or f"Comprehensive automation script for {pascal_name}"
    author_name: str = author or "axler8r"
    current_date: str = datetime.now().strftime('%Y-%m-%d')
    
    return f'''#!/usr/bin/env zsh

# Script: {pascal_name}
# Author: {author_name}
# Description: {desc}
# Version: {version}
# Created: {current_date}

set -euo pipefail  # Exit on error, undefined vars, pipe failures

# Script metadata
readonly SCRIPT_NAME="${{0:t}}"
readonly SCRIPT_DIR="${{0:A:h}}"
readonly VERSION="{version}"

# Default values
typeset -i VERBOSE=0
typeset -i DRY_RUN=0
typeset -i FORCE=0

# Color codes for output
readonly RED="\\033[0;31m"
readonly GREEN="\\033[0;32m"
readonly YELLOW="\\033[1;33m"
readonly BLUE="\\033[0;34m"
readonly NC="\\033[0m" # No Color

#==============================================================================
# Functions
#==============================================================================

show_synopsis() {{
    cat << EOF
SYNOPSIS
    ${{SCRIPT_NAME}} [OPTIONS] [ARGUMENTS]

    {desc}
EOF
}}

show_help() {{
    show_synopsis
    cat << EOF

DESCRIPTION
    Detailed description of what this script does and its purpose.

OPTIONS
    -h, --help      Show this help message and exit
    -v, --verbose   Enable verbose output
    -V, --version   Show version information
    -n, --dry-run   Show what would be done without actually doing it
    -f, --force     Force operation without confirmation prompts

ARGUMENTS
    arg1            Description of first argument
    arg2            Description of second argument (optional)

EXAMPLES
    ${{SCRIPT_NAME}} --verbose file.txt
    ${{SCRIPT_NAME}} --dry-run --force /path/to/directory

EXIT CODES
    0    Success
    1    General error
    2    Invalid arguments

AUTHOR
    {author_name}

VERSION
    {version}
EOF
}}

show_version() {{
    echo "${{SCRIPT_NAME}} version ${{VERSION}}"
}}

# Logging functions
log_info() {{ echo -e "${{BLUE}}[INFO]${{NC}} $*" >&2; }}
log_warn() {{ echo -e "${{YELLOW}}[WARN]${{NC}} $*" >&2; }}
log_error() {{ echo -e "${{RED}}[ERROR]${{NC}} $*" >&2; }}
log_success() {{ echo -e "${{GREEN}}[SUCCESS]${{NC}} $*" >&2; }}
log_verbose() {{ [[ ${{VERBOSE}} -eq 1 ]] && echo -e "${{BLUE}}[VERBOSE]${{NC}} $*" >&2; }}

error_exit() {{
    local exit_code=${{2:-1}}
    log_error "$1"
    exit ${{exit_code}}
}}

confirm() {{
    [[ ${{FORCE}} -eq 1 ]] && return 0
    local message="$1"
    echo -n "${{message}} (y/N): "
    read -r response
    [[ ${{response}} =~ ^[yY]([eE][sS])?$ ]]
}}

check_dependencies() {{
    local missing_deps=()
    local required_commands=(
        # Add required commands here
    )
    
    for cmd in ${{required_commands[@]}}; do
        command -v ${{cmd}} &> /dev/null || missing_deps+=(${{cmd}})
    done
    
    [[ ${{#missing_deps[@]}} -gt 0 ]] && error_exit "Missing: ${{missing_deps[*]}}"
}}

cleanup() {{
    log_verbose "Cleaning up..."
}}

#==============================================================================
# Main Functions
#==============================================================================

{snake_name}() {{
    local arg=${{1:-}}
    
    log_verbose "Starting {pascal_name} with argument: ${{arg}}"
    
    if [[ ${{DRY_RUN}} -eq 1 ]]; then
        log_info "DRY RUN: Would execute {pascal_name}"
        return 0
    fi
    
    [[ -z "${{arg}}" ]] && error_exit "Missing required argument" 2
    
    log_info "Processing..."
    echo "Executing {pascal_name} with: ${{arg}}"
    log_success "Completed successfully"
}}

#==============================================================================
# Argument Parsing
#==============================================================================

parse_arguments() {{
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)    show_help; exit 0 ;;
            -V|--version) show_version; exit 0 ;;
            -v|--verbose) VERBOSE=1; shift ;;
            -n|--dry-run) DRY_RUN=1; shift ;;
            -f|--force)   FORCE=1; shift ;;
            -*)           error_exit "Unknown option: $1" 2 ;;
            *)
                if [[ -z "${{ARG1:-}}" ]]; then ARG1="$1"
                elif [[ -z "${{ARG2:-}}" ]]; then ARG2="$1"
                else error_exit "Too many arguments" 2
                fi
                shift ;;
        esac
    done
}}

#==============================================================================
# Main Script
#==============================================================================

main() {{
    trap cleanup EXIT
    parse_arguments "$@"
    check_dependencies
    
    [[ -z "${{ARG1:-}}" ]] && show_synopsis && error_exit "Missing required argument" 2
    
    {snake_name} "${{ARG1}}"
}}

[[ "${{ZSH_EVAL_CONTEXT:-}}" == "toplevel" ]] && main "$@"
'''


def create_argument_parser() -> argparse.ArgumentParser:
    """Create and configure argument parser"""
    default_dir = get_default_output_dir()
    
    parser = argparse.ArgumentParser(
        prog='New-Function',
        description='Generate zsh wrappers, functions, and scripts with PascalCase naming',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=f"""
Template Types:
  wrapper    1-15 lines   - Simple command wrappers
  function   16-80 lines  - Structured functions with options
  script     81+ lines    - Full-featured automation scripts

Naming:
  Accepts both PascalCase (Get-Data) and lowercase (get-data)
  Files are created with PascalCase names (Get-Data)

Default output: {default_dir}

Examples:
  New-Function wrapper Get-Weather
  New-Function function --description "Process log files" Process-Logs
  New-Function script --author "axler8r" Deploy-App
  New-Function --dry-run function Test-Function

Exit codes:
  0    Success
  1    General error
  2    Invalid arguments
        """
    )
    
    parser.add_argument(
        'type',
        choices=['wrapper', 'function', 'script'],
        help='Type of template to generate'
    )
    
    parser.add_argument(
        'name',
        help='Name of the function (Verb-Noun, e.g., Get-Data or get-data)'
    )
    
    parser.add_argument(
        '-o', '--output',
        type=Path,
        default=default_dir,
        help=f'Output directory (default: {default_dir})'
    )
    
    parser.add_argument(
        '-d', '--description',
        help='Brief description of what the function does'
    )
    
    parser.add_argument(
        '-a', '--author',
        default='axler8r',
        help='Author name (default: axler8r)'
    )
    
    parser.add_argument(
        '--version-number',
        default='1.0',
        dest='version_num',
        help='Version number for script templates (default: 1.0)'
    )
    
    parser.add_argument(
        '-n', '--dry-run',
        action='store_true',
        help='Print template to stdout without creating file'
    )
    
    parser.add_argument(
        '-f', '--force',
        action='store_true',
        help='Overwrite existing file without prompting'
    )
    
    parser.add_argument(
        '-v', '--verbose',
        action='store_true',
        help='Enable verbose output'
    )
    
    return parser


def main() -> None:
    """Main entry point"""
    parser: argparse.ArgumentParser = create_argument_parser()
    args: argparse.Namespace = parser.parse_args()
    
    logger = Logger(args.verbose)
    
    # Validate function name
    if not validate_name(args.name):
        error_exit(
            f"Invalid name '{args.name}'. Must follow Verb-Noun convention (e.g., Get-Data, get-data)",
            2
        )
    
    # Normalize to PascalCase
    pascal_name = to_pascal_case(args.name)
    logger.verbose_log(f"Generating {args.type} template: {pascal_name}")
    
    # Generate appropriate template
    if args.type == 'wrapper':
        template: str = generate_wrapper_template(pascal_name)
    elif args.type == 'function':
        template = generate_function_template(pascal_name, args.description)
    else:  # script
        template = generate_script_template(pascal_name, args.description, args.author, args.version_num)
    
    # Dry run: just print to stdout
    if args.dry_run:
        print(template)
        return
    
    # Write to file
    output_path = args.output / pascal_name
    
    logger.verbose_log(f"Output path: {output_path}")
    
    # Check if file exists
    if output_path.exists() and not args.force:
        response: str = input(f"File {output_path} already exists. Overwrite? (y/N): ")
        if response.lower() not in ['y', 'yes']:
            logger.warn("Aborted by user")
            sys.exit(0)
    
    # Create output directory if needed
    try:
        args.output.mkdir(parents=True, exist_ok=True)
        logger.verbose_log(f"Ensured output directory exists: {args.output}")
    except Exception as e:
        error_exit(f"Failed to create output directory: {e}")
    
    # Write template to file
    try:
        output_path.write_text(template)
        output_path.chmod(0o755)
        logger.success(f"Created {args.type}: {output_path}")
    except Exception as e:
        error_exit(f"Failed to write template: {e}")


if __name__ == "__main__":
    main()
