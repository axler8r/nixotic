#! /usr/bin/env zsh

# New-DevEnvironment: Create a direnv + flake-parts development environment

source "${0:h}/../lib/output.zsh"
source "${0:h}/../lib/validation.zsh"

# Variables --------------------------------------------------------------------
local _synopsis="Synopsis:
    ${0:t} [opts] [packages...]

See also:
    ${0:t} --help
"
local _help="Description:
    Create a new direnv + Nix Flakes development environment using flake-parts.
    Nix provides the runtime and essential tooling. Use language-native tools
    (uv, mix, dotnet) to manage project dependencies.

Usage:
    ${0:t} [opts] [packages...]

Options:
    --help              Show this help message
    --name NAME         Project name (default: current directory name)
    --lang LANG         Language template: python, elixir, dotnet

Arguments:
    packages            Additional Nix packages (bare names, e.g. jq ripgrep)

Language Templates:
    python              python3, uv              → use uv for deps
    elixir              elixir                   → use mix for deps
    dotnet              dotnet-sdk               → use dotnet CLI for deps

Examples:
    ${0:t} --lang python                        # Python with uv
    ${0:t} --lang elixir                        # Elixir with mix
    ${0:t} --lang dotnet                        # .NET with dotnet CLI
    ${0:t} --lang python jq ripgrep             # Python + extra tools
    ${0:t} jq fd ripgrep                        # Ad-hoc shell, no language template
"

# Defaults
local _name="${PWD:t}"
local _lang=""
local _help_flag=""
local -a _packages=()


# Functions --------------------------------------------------------------------
_synopsis() { echo "${_synopsis}" | tail --lines=+2 }
_help() { echo "${_help}" | tail --lines=+2 }


# Options ----------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
    case "$1" in
        --help)     _help_flag=true; shift ;;
        --name)     _name="$2"; shift 2 ;;
        --lang)     _lang="$2"; shift 2 ;;
        -*)         __ax_error "Unknown option: $1" && return 1 ;;
        *)          _packages+=("$1"); shift ;;
    esac
done


# Main -------------------------------------------------------------------------
[[ -n $_help_flag ]] && _help && return 0
__ax_check_deps direnv nix || return 2

if [[ -z "$_lang" ]] && [[ ${#_packages[@]} -eq 0 ]]; then
    _synopsis
    return 1
fi


# Driver -----------------------------------------------------------------------
function new_dev_environment() {
    local name="$1"
    local lang="$2"
    shift 2
    local -a extra_packages=("$@")

    if [[ -f flake.nix ]]; then
        __ax_error "flake.nix already exists"
        return 1
    fi

    if [[ -n "$lang" ]] && [[ ! "$lang" =~ ^(python|elixir|dotnet)$ ]]; then
        __ax_error "Unknown language: $lang (supported: python, elixir, dotnet)"
        return 1
    fi

    # Language package names
    local -a lang_pkg_names=()
    case "$lang" in
        python)  lang_pkg_names=(python3 uv) ;;
        elixir)  lang_pkg_names=(elixir) ;;
        dotnet)  lang_pkg_names=(dotnet-sdk) ;;
    esac

    # Build packages block (12-space indent, one package per line)
    local all_packages=""
    local -a all_pkg_names=("${lang_pkg_names[@]}" "${extra_packages[@]}")
    if [[ ${#all_pkg_names[@]} -gt 0 ]]; then
        all_packages=$(printf '            pkgs.%s\n' "${all_pkg_names[@]}")
        all_packages="${all_packages%$'\n'}"
    fi

    # Per-language env attrs
    local env_attrs=""
    if [[ "$lang" == "dotnet" ]]; then
        env_attrs=$'\n          DOTNET_CLI_TELEMETRY_OPTOUT = "1";\n          DOTNET_NOLOGO = "1";'
    fi

    # Create flake.nix
    cat > flake.nix << EOF
{
  description = "${name} development environment";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    flake-parts.url = "github:hercules-ci/flake-parts";
  };

  outputs = inputs@{ flake-parts, ... }:
    flake-parts.lib.mkFlake { inherit inputs; } {
      systems = [ "x86_64-linux" "aarch64-linux" "x86_64-darwin" "aarch64-darwin" ];

      perSystem = { pkgs, ... }: {
        devShells.default = pkgs.mkShell {
          name = "${name}";
          packages = [
${all_packages}
          ];${env_attrs}
        };
      };
    };
}
EOF

    echo "Created flake.nix"

    echo "use flake" > .envrc
    echo "Created .envrc"

    if [[ -f .gitignore ]]; then
        if ! grep -q "^\.direnv$" .gitignore; then
            echo ".direnv" >> .gitignore
            echo "Added .direnv to .gitignore"
        fi
    fi

    direnv allow
    echo "Environment activated"
}


new_dev_environment "$_name" "$_lang" "${_packages[@]}"


# Cleanup ----------------------------------------------------------------------
unfunction _synopsis _help new_dev_environment 2>/dev/null
