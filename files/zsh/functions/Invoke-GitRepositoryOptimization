#! /usr/bin/env zsh

# Invoke-GitRepositoryOptimization: Optimize git repositories by running gc and prune

source "${0:h}/../lib/output.zsh"
source "${0:h}/../lib/validation.zsh"

[[ "$1" == "--help" ]] && echo "Usage: ${0:t} [--log <path>] <dir>... - Optimize git repositories" && return 0

__ax_check_deps git parallel || return 2

local _log_path=""
local -a _dirs
while [[ $# -gt 0 ]]; do
    case "$1" in
        --log)
            shift
            __ax_require_arg "$1" "log path" || return 1
            _log_path="$1"
            ;;
        -h|--help)
            echo "Usage: ${0:t} [--log <path>] <dir>... - Optimize git repositories"
            return 0
            ;;
        -*)
            __ax_error "Unknown option: $1"
            return 1
            ;;
        *)
            _dirs+=("$1")
            ;;
    esac
    shift
done

__ax_require_arg "${_dirs[1]}" "directory" || { echo "Usage: ${0:t} [--log <path>] <dir>..."; return 1; }

local _git_dirs=()
foreach _dir in "${_dirs[@]}"; do
    [[ -d "$_dir" && -d "$_dir/.git" ]] && _git_dirs+=("${_dir}")
done

if [[ ${#_git_dirs[@]} -eq 0 ]]; then
    __ax_warn "No git repositories found in the provided directories."
    return 0
fi

local _command=$(cat << EOL
git -C {} fetch --prune \
&& git -C {} fsck --full \
&& git -C {} reflog expire --expire=90.days.ago \
&& git -C {} gc --prune=90.days.ago
EOL
)

local -a _parallel_args=(--jobs 4 --progress)
[[ -n "$_log_path" ]] && _parallel_args+=(--joblog "$_log_path")

parallel "${_parallel_args[@]}" "${_command}" ::: "${_git_dirs[@]}"
