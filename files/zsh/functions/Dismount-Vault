#! /usr/bin/env zsh

# dismount-vault: Unmount and close a LUKS encrypted vault

# Help
if [[ "$1" == "--help" ]]; then
    cat << EOF
Usage: ${0:t} <vault-name-or-mount-point>

Description:
    Unmount a LUKS encrypted vault and close the cryptsetup mapping.
    Specify a vault name (e.g., 'mydata') or mount point path.

Arguments:
    vault-name-or-mount-point    Vault name (e.g., mydata) or mount point (e.g., ~/Vaults/mydata)

Examples:
    ${0:t} mydata
    ${0:t} ~/Vaults/mydata
EOF
    return 0
fi

# Validate argument
if [[ -z "$1" ]]; then
    echo "Error: Mount point or vault name required"
    echo "Usage: ${0:t} <mount-point-or-vault-name>"
    return 1
fi

# Main logic
local target="$1"
local mapper_name=""
local mount_point=""

# Check if target is a mount point
if [[ -d "${target}" ]] && mount | grep --quiet " on ${target} "; then
    mount_point="${target}"
    # Extract mapper name from mount
    mapper_name=$(mount | grep " on ${target} " | awk '{print $1}' | sed 's|/dev/mapper/||')
# Check if target is a vault name
elif [[ "${target}" != /* ]]; then
    mapper_name="${target}"
    mount_point=$(mount | grep "/dev/mapper/${mapper_name} " | awk '{print $3}')
else
    echo "Error: Invalid mount point or vault not mounted: ${target}"
    return 1
fi

# Verify mapper exists
if [[ ! -e "/dev/mapper/${mapper_name}" ]]; then
    echo "Error: Vault mapper not found: ${mapper_name}"
    return 1
fi

echo "Unmounting: ${mount_point}"
sudo umount "${mount_point}" || return 1

echo "Closing vault: ${mapper_name}"
sudo cryptsetup close "${mapper_name}" || return 1

echo "Vault dismounted successfully"

