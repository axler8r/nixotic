#! /usr/bin/env zsh

# Get-SwapUsage: Display swap memory usage by process

source "${0:h}/../lib/output.zsh"
source "${0:h}/../lib/validation.zsh"

# Options/Arguments ---------------------------------------------------------
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat << EOF
Usage: ${0:t} [opts]

Description:
    Display swap memory usage for all processes currently using swap.
    Results are sorted by swap usage with highest usage first.
    Output format: swap usage (KB) | process ID | process name

Options:
    -h, --help    Show this help message
    --raw         Display output in raw format

Examples:
    ${0:t}
EOF
    return 0
fi

local _raw_flag=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --raw)      _raw_flag="--raw" ;;
        *)          __ax_error "Unknown option: $1" && return 1 ;;
    esac
    shift
done


# Main -------------------------------------------------------------------------
__ax_check_deps awk grep file sort || return 2


# Driver -----------------------------------------------------------------------
function get_swap_usage() {
    local _rows=""
    local swap name pid

    foreach dir in /proc/*/; do
        pid=$(basename $dir)
        if [[ $pid =~ ^[0-9]+$ ]]; then
            swap=$(grep VmSwap $dir/status 2>/dev/null | awk '{print $2}')
            if [[ -n $swap && $swap -gt 0 ]]; then
                name=$(grep "^Name:" $dir/status 2>/dev/null | awk '{print $2}')
                local fmt_swap=$(printf "%'d KB" "$swap")
                _rows+="\n${fmt_swap}|${pid}|${name}"
            fi
        fi
    done

    if [[ -z "$_rows" ]]; then
        __ax_info "No processes currently using swap."
        return 0
    fi

    # Sort by swap usage descending (numeric on first field)
    local _sorted
    _sorted=$(echo -e "$_rows" | tail -n +2 | sort -t'|' -k1 -rn)

    echo ""
    echo -e "Swap|PID|Process\n${_sorted}" | __ax_table $_raw_flag
    echo ""
}


get_swap_usage
