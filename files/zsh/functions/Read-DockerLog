#! /usr/bin/env zsh

# Read-DockerLog: Read and follow Docker container logs

source "${0:h}/../lib/output.zsh"
source "${0:h}/../lib/validation.zsh"

# Help check ---------------------------------------------------------------
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat << EOF
Usage: ${0:t} <CONTAINER_NAME>

Reads the output of docker container log.

Options:
    -h, --help    Show this help message

Examples:
    ${0:t} <CONTAINER_NAME>
EOF
    return 0
fi


# Main -------------------------------------------------------------------------
local _arg=$1
__ax_require_arg "$_arg" "container name" || return 1
__ax_check_deps docker || return 2


# Driver -----------------------------------------------------------------------
function read_dockerlog() {
    docker logs "${_arg}" 2>&1
}


read_dockerlog "${_arg}"


unfunction read_dockerlog
