#! /usr/bin/env zsh

# Enter-NixShell: Enter an ephemeral nix shell with an ad-hoc set of packages

source "${0:h}/../lib/output.zsh"
source "${0:h}/../lib/validation.zsh"

# Defaults
local -a _packages=()


# Help check ------------------------------------------------------------------
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat << EOF
Usage: ${0:t} packages...

Description:
    Enter an ephemeral Nix shell with an ad-hoc set of packages. Nothing is
    written to disk (no flake.nix, no .envrc) — the shell exists only for
    the current terminal session. The prompt shows the active package set
    for the duration of the shell.

Arguments:
    packages                Nix packages (bare names, e.g. jq ripgrep)
                             An argument containing '#' is treated as a full
                             flake ref and passed through unchanged.

Examples:
    ${0:t} jq ripgrep                  # nix shell nixpkgs#jq nixpkgs#ripgrep
    ${0:t} github:foo/bar#baz          # Ad-hoc shell from another flake
EOF
    return 0
fi


# Options ----------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
    case "$1" in
        -*)         __ax_error "Unknown option: $1"; return 1 ;;
        *)          _packages+=("$1"); shift ;;
    esac
done


# Main -------------------------------------------------------------------------
__ax_check_deps nix || return 2

if [[ ${#_packages[@]} -eq 0 ]]; then
    __ax_error "Usage: ${0:t} packages..."
    __ax_info "Use --help for more information"
    return 1
fi


# Driver -----------------------------------------------------------------------
function enter_nix_shell() {
    local -a packages=("$@")
    local -a installables=()
    local pkg

    for pkg in "${packages[@]}"; do
        if [[ "$pkg" == *"#"* ]]; then
            installables+=("$pkg")
        else
            installables+=("nixpkgs#${pkg}")
        fi
    done

    IN_NIX_SHELL=impure name="${(j: :)packages}" command nix shell "${installables[@]}"
}


enter_nix_shell "${_packages[@]}"


# Cleanup ----------------------------------------------------------------------
unfunction enter_nix_shell 2>/dev/null
