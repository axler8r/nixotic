#! /usr/bin/env zsh

# Clear-FileSystemCache: Clear the filesystem cache

source "${0:h}/../lib/output.zsh"
source "${0:h}/../lib/validation.zsh"

[[ "$1" == "--help" ]] && echo "Usage: ${0:t}" && return 0

__ax_check_deps sync tee || return 2

sudo sync && echo 3 | sudo tee /proc/sys/vm/drop_caches
