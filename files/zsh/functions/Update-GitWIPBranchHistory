#! /usr/bin/env zsh

# Update-GitWIPBranchHistory: Interactively rebase the current WIP branch onto stable

source "${0:h}/../lib/output.zsh"
source "${0:h}/../lib/validation.zsh"
source "${0:h}/../lib/git.zsh"

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat << EOF
Usage: ${0:t}

Interactively rebase the current wip/* branch onto stable.

Requirements:
  - Inside a Git repository
  - Clean Git worktree
  - Currently on a wip/* branch
  - Local stable branch exists
EOF
    return 0
fi

__ax_require_git_repo || return $?
__ax_require_clean_git_worktree || return 1
__ax_require_branch_exists stable || return 1
__ax_require_wip_branch || return 1

git rebase --interactive stable || return 1

__ax_success "Updated WIP branch history."
