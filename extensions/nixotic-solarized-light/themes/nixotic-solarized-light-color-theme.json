{
  "name": "Nixotic Solarized Light",
  "semanticHighlighting": true,
  "tokenColors": [
    {
      "name": "Default foreground",
      "settings": { "foreground": "#839496" }
    },
    {
      "name": "Embedded / fallback contexts",
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "string meta.image.inline.markdown",
        "variable.legacy.builtin.python"
      ],
      "settings": { "foreground": "#839496" }
    },
    {
      "name": "code.comment / code.doc_comment",
      "scope": [
        "comment",
        "comment.block.documentation",
        "punctuation.definition.comment"
      ],
      "settings": { "foreground": "#839496", "fontStyle": "italic" }
    },
    {
      "name": "code.keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.word",
        "storage.type",
        "storage.modifier"
      ],
      "settings": { "foreground": "#859900", "fontStyle": "bold" }
    },
    {
      "name": "code.variable / code.constant / json.key / yaml.key / toml.key / css.property / markup.attribute",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.language",
        "variable.parameter",
        "constant",
        "constant.other",
        "constant.language",
        "support.constant",
        "support.variable",
        "support.type.property-name",
        "entity.other.attribute-name",
        "meta.object-literal.key",
        "meta.structure.dictionary.key",
        "entity.name.tag.yaml"
      ],
      "settings": { "foreground": "#268bd2" }
    },
    {
      "name": "code.type / css.selector / toml.header / yaml.tag",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.interface",
        "support.type",
        "support.class",
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.name.tag.toml"
      ],
      "settings": { "foreground": "#b58900" }
    },
    {
      "name": "code.literal.string / number / bool / null / shell.string / shell.heredoc",
      "scope": [
        "string",
        "string.quoted",
        "string.unquoted",
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null"
      ],
      "settings": { "foreground": "#2aa198" }
    },
    {
      "name": "code.function / css.function",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "variable.function"
      ],
      "settings": { "foreground": "#cb4b16", "fontStyle": "italic" }
    },
    {
      "name": "code.import / code.macro / markup.doctype / css.at_rule / yaml.anchor",
      "scope": [
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.include",
        "keyword.control.at-rule",
        "entity.name.namespace",
        "meta.preprocessor",
        "meta.tag.sgml.doctype",
        "entity.name.annotation",
        "storage.type.annotation",
        "punctuation.definition.anchor.yaml",
        "entity.name.type.anchor.yaml"
      ],
      "settings": { "foreground": "#d33682" }
    },
    {
      "name": "code.interpolation / code.regex / markup.entity / yaml.alias",
      "scope": [
        "string.regexp",
        "constant.character.escape",
        "constant.other.placeholder",
        "constant.character.entity",
        "meta.interpolation",
        "punctuation.definition.interpolation",
        "punctuation.definition.alias.yaml",
        "variable.other.alias.yaml"
      ],
      "settings": { "foreground": "#6c71c4" }
    },
    {
      "name": "code.operator / code.punctuation / yaml.document / diff.file_header",
      "scope": [
        "punctuation",
        "punctuation.definition",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.section",
        "keyword.operator",
        "meta.directive.yaml",
        "meta.diff.header"
      ],
      "settings": { "foreground": "#839496" }
    },
    {
      "name": "markup.tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": { "foreground": "#859900", "fontStyle": "bold" }
    },
    {
      "name": "diff.added",
      "scope": "markup.inserted",
      "settings": { "foreground": "#859900" }
    },
    {
      "name": "diff.deleted",
      "scope": "markup.deleted",
      "settings": { "foreground": "#dc322f" }
    },
    {
      "name": "diff.changed",
      "scope": "markup.changed",
      "settings": { "foreground": "#b58900" }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": { "foreground": "#dc322f", "fontStyle": "bold" }
    },
    {
      "name": "Markdown heading",
      "scope": "markup.heading",
      "settings": { "foreground": "#268bd2", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": "markup.bold",
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": "markup.italic",
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markdown strikethrough",
      "scope": "markup.strikethrough",
      "settings": { "fontStyle": "strikethrough" }
    },
    {
      "name": "Markdown inline raw",
      "scope": "markup.inline.raw",
      "settings": { "foreground": "#2aa198" }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": { "foreground": "#268bd2", "fontStyle": "underline" }
    }
  ],
  "colors": {
